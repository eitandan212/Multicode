{
  "name": "multicode",
  "version": "0.3.4",
  "description": "Connect your AI subscriptions and API keys \u2014 and let them build together as a crew.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "multicode": "dist/server/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "test": "vitest run",
    "desktop": "npm run build && electron .",
    "icons": "node scripts/icons.mjs",
    "dist:win": "npm run build && electron-builder --win dir --x64 && node scripts/win-installer.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.321",
    "@anthropic-ai/sdk": "^1.13.0",
    "@effect/platform-node": "4.1.5",
    "@google/genai": "^3.6.1",
    "diff": "^8.0.4",
    "effect": "4.1.5",
    "express": "^5.3.0",
    "openai": "^7.63.0"
  },
  "devDependencies": {
    "@lobehub/icons-static-svg": "^1.106.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12",
    "monaco-editor": "0.57.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "resedit": "^3.1.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "main": "desktop/main.js",
  "author": "MultiCode",
  "homepage": "https://github.com/eitandan212/multicode",
  "build": {
    "appId": "com.multicode.desktop",
    "productName": "MultiCode",
    "copyright": "Copyright \u00a9 2026 MultiCode",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "desktop/main.js",
      "desktop/preload.cjs",
      "desktop/updater.js",
      "build/icon.ico",
      "build/icon.png",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**",
      "!node_modules/effect/src/**",
      "!node_modules/effect/ai-docs/**",
      "!node_modules/@effect/*/src/**",
      "!node_modules/**/*.js.map",
      "!node_modules/**/*.d.ts.map",
      "!node_modules/openai/src/**",
      "!node_modules/@anthropic-ai/sdk/src/**",
      "!node_modules/**/*.d.ts",
      "!node_modules/**/*.d.mts",
      "!node_modules/**/*.d.cts"
    ],
    "asar": true,
    "afterPack": "desktop/afterPack.cjs",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MultiCode",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "MultiCode-Setup-${version}.exe",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "electronLanguages": [
      "en-US",
      "he"
    ]
  }
}
